+/*
+ * ntfsoficial: metadados do Finder a partir dos atributos NTFS, como o driver do Tuxera (REA: FUN_10000a758,
+ * trecho que preenche st_flags e a data de criação):
+ *   HIDDEN   -> UF_HIDDEN (o Finder esconde o arquivo)
+ *   READONLY -> UF_IMMUTABLE (o macOS recusa apagar/gravar, como o Windows faz com somente leitura)
+ *   sem ARCHIVE (e não diretório) -> SF_ARCHIVED (já houve backup)
+ *   data de criação NTFS -> st_birthtime
+ * Só para arquivos de usuário (registro MFT >= 16): os arquivos de sistema ($MFT, $Boot, a raiz...) não ganham flags.
+ * DIVERGÊNCIA do Tuxera: UF_IMMUTABLE só em arquivo comum, nunca em diretório nem em link simbólico. O Windows usa
+ * READONLY em pastas só para marcar "pasta personalizada" (desktop.ini) e não impede gravar nelas; com
+ * UF_IMMUTABLE o macOS passaria a recusar criar arquivos dentro da pasta.
+ */
+static void ntfs_fuse_getstat_finder(ntfs_inode *ni, struct stat *stbuf)
+{
+	u32 flags = 0;
+
+	stbuf->st_birthtimespec = ntfs2timespec(ni->creation_time);
+	if (ni->mft_no >= FILE_first_user) {
+		if (ni->flags & FILE_ATTR_HIDDEN)
+			flags |= UF_HIDDEN;
+		if ((ni->flags & FILE_ATTR_READONLY) && S_ISREG(stbuf->st_mode))
+			flags |= UF_IMMUTABLE;
+		if (!(ni->flags & FILE_ATTR_ARCHIVE)
+		    && !(ni->mrec->flags & MFT_RECORD_IS_DIRECTORY))
+			flags |= SF_ARCHIVED;
+	}
+	stbuf->st_flags = flags;
+}
+#endif /* defined(__APPLE__) || defined(__DARWIN__) */
 
