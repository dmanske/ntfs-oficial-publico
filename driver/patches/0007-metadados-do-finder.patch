+#if defined(__APPLE__) || defined(__DARWIN__)
+/*
+ * ntfsoficial: datas de criação/mudança/backup e flags (chflags) do macOS -> atributos NTFS, como o setattr_x do
+ * Tuxera (REA: FUN_10000e910). Mapa dos flags:
+ *   UF_HIDDEN                  <-> FILE_ATTR_HIDDEN
+ *   UF_IMMUTABLE/SF_IMMUTABLE  <-> FILE_ATTR_READONLY (só arquivo comum; diretório e link ficam como estão, ver
+ *                                  ntfs_fuse_getstat_finder)
+ *   SF_ARCHIVED                <-> ausência de FILE_ATTR_ARCHIVE (só fora de diretório)
+ * Outros bits (UF_NODUMP, UF_OPAQUE...) não têm equivalente no NTFS e são ignorados; o Tuxera ignora o pedido
+ * inteiro se vier um bit desconhecido, aqui os bits conhecidos são aplicados.
+ * Data de backup: não há campo no NTFS (o Tuxera usa o stream AFP_AfpInfo); o pedido é aceito e descartado, e o
+ * getxtimes devolve 0.
+ * Registros de sistema (MFT < 16) não são alterados.
+ */
+static int ntfs_fuse_setxtimes_flags(fuse_req_t req, fuse_ino_t ino,
+			struct setattr_x *ax, unsigned int to_set, struct stat *stbuf)
+{
+	struct SECURITY_CONTEXT security;
+	ntfs_inode *ni;
+	int res = 0;
+
+	if (NVolReadOnly(ctx->vol))
+		return -EROFS;
+	ntfs_fuse_fill_security_context(req, &security);
+	ni = ntfs_inode_open(ctx->vol, INODE(ino));
+	if (!ni)
+		return -errno;
 #if !KERNELPERMS | (POSIXACLS & !KERNELACLS)
+	if (!ntfs_allowed_as_owner(&security, ni)) {
+		res = -errno;
+		goto fim;
+	}
+#endif
+	if (ni->mft_no >= FILE_first_user) {
+		if (to_set & FUSE_SET_ATTR_FLAGS) {
+			u32 atual = le32_to_cpu(ni->flags);
+			u32 novo = atual;
+			u32 fl = ax->flags;
 
+			if (fl & UF_HIDDEN)
+				novo |= le32_to_cpu(FILE_ATTR_HIDDEN);
+			else
+				novo &= ~le32_to_cpu(FILE_ATTR_HIDDEN);
+			if (!(ni->mrec->flags & MFT_RECORD_IS_DIRECTORY)) {
+				if (!(ni->flags & FILE_ATTR_REPARSE_POINT)) {
+					if (fl & (UF_IMMUTABLE | SF_IMMUTABLE))
+						novo |= le32_to_cpu(FILE_ATTR_READONLY);
+					else
+						novo &= ~le32_to_cpu(FILE_ATTR_READONLY);
+				}
+				if (fl & SF_ARCHIVED)
+					novo &= ~le32_to_cpu(FILE_ATTR_ARCHIVE);
+				else
+					novo |= le32_to_cpu(FILE_ATTR_ARCHIVE);
+			}
+			if (novo != atual
+			    && ntfs_set_ntfs_attrib(ni, (const char*)&novo,
+						sizeof(novo), 0))
+				res = -errno;
+		}
+		if (!res && (to_set & FUSE_SET_ATTR_CRTIME))
+			ni->creation_time = timespec2ntfs(ax->crtime);
+		/*
+		 * a mudança de metadados atualiza o ctime, a não ser que o chamador tenha dado um valor
+		 * (aí o valor dele vale, e por isso é gravado depois)
+		 */
+		if (!res) {
+			ntfs_fuse_update_times(ni, NTFS_UPDATE_CTIME);
+			if (to_set & FUSE_SET_ATTR_CHGTIME)
+				ni->last_mft_change_time = timespec2ntfs(ax->chgtime);
+			NInoSetDirty(ni);
+		}
+	}
+	if (!res)
+		res = ntfs_fuse_getstat(&security, ni, stbuf);
+#if !KERNELPERMS | (POSIXACLS & !KERNELACLS)
+fim:
+#endif
+	if (ntfs_inode_close(ni))
+		set_fuse_error(&res);
+	return res;
+}
+
+static void ntfs_fuse_setattr_x(fuse_req_t req, fuse_ino_t ino,
+			struct setattr_x *ax, int to_set,
+			struct fuse_file_info *fi)
+{
+	const unsigned int comum = FUSE_SET_ATTR_MODE | FUSE_SET_ATTR_UID
+			| FUSE_SET_ATTR_GID | FUSE_SET_ATTR_SIZE
+			| FUSE_SET_ATTR_ATIME | FUSE_SET_ATTR_MTIME;
+	const unsigned int extras = FUSE_SET_ATTR_CRTIME | FUSE_SET_ATTR_CHGTIME
+			| FUSE_SET_ATTR_BKUPTIME | FUSE_SET_ATTR_FLAGS;
+	struct stat st;
+	struct stat stbuf;
+	int res;
+
+	memset(&st, 0, sizeof(st));
+	st.st_mode = ax->mode;
+	st.st_uid = ax->uid;
+	st.st_gid = ax->gid;
+	st.st_size = ax->size;
+	st.st_atimespec = ax->acctime;
+	st.st_mtimespec = ax->modtime;
+	res = ntfs_fuse_setattr_core(req, ino, &st, (unsigned int)to_set & comum, fi, &stbuf);
+	if (!res && ((unsigned int)to_set & extras))
+		res = ntfs_fuse_setxtimes_flags(req, ino, ax, (unsigned int)to_set, &stbuf);
+	if (res)
+		fuse_reply_err(req, -res);
+	else
+		fuse_reply_attr(req, &stbuf, ATTR_TIMEOUT);
+}
+#endif /* defined(__APPLE__) || defined(__DARWIN__) */
