+		s64 r;
+
+		if (pos < 0)
+			return -1;
+		r = pread_alinhado(DEV_FD(dev), DEV_SETOR(dev), buf, count, pos);
+		if (r > 0)
+			lseek(DEV_FD(dev), pos + r, SEEK_SET);
+		return r;
+	}
+#endif
 	return read(DEV_FD(dev), buf, count);
 }
 
