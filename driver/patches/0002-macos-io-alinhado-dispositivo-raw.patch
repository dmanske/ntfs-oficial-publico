+++ b/ntfs-3g/libntfs-3g/unix_io.c	2026-10-17 17:28:14
@@ -66,6 +66,105 @@
 
 #define DEV_FD(dev)	(*(int *)dev->d_private)
 
+#if defined(__APPLE__) || defined(__DARWIN__)
+#include <sys/disk.h>
+/*
+ * ntfsoficial: E/S alinhada para o dispositivo "raw" do macOS (/dev/rdiskN).
+ *
+ * O dispositivo de bloco (/dev/diskN) aceita qualquer tamanho, mas quebra as gravações em blocos pequenos
+ * e síncronos: 21 MB/s num SSD USB (17/10/2026). O raw é bem mais rápido, mas só aceita leituras e gravações
+ * em múltiplos do setor; o NTFS-3G pede tamanhos quebrados e falha ("ntfs_pread failed: Invalid argument").
+ * O driver do Tuxera resolve com o aligned_io.c ("built with USE_ALIGNED_IO", visto com o REA).
+ *
+ * Aqui: pedidos já alinhados vão direto; os outros leem o trecho alinhado que cobre o pedido e, na gravação,
+ * trocam só os bytes pedidos antes de gravar o trecho inteiro (ler-modificar-gravar).
+ * O primeiro campo continua sendo o descritor, então DEV_FD() segue valendo.
+ */
+struct unix_io_privado {
+	int fd;
+	u32 setor;	/* 0 = não precisa alinhar (arquivo ou dispositivo de bloco) */
+};
+#define DEV_SETOR(dev)	(((struct unix_io_privado *)dev->d_private)->setor)
+
+static void trecho_alinhado(u32 setor, s64 offset, s64 count, s64 *inicio, s64 *tam)
+{
+	s64 fim = offset + count;
+
+	*inicio = offset - offset % setor;
+	if (fim % setor)
+		fim += setor - fim % setor;
+	*tam = fim - *inicio;
+}
+
+static s64 pread_alinhado(int fd, u32 setor, void *buf, s64 count, s64 offset)
+{
+	s64 inicio, tam, desloc, disp, r;
+	ssize_t n;
+	char *tmp;
+	int err;
+
+	if (!setor || (!(offset % setor) && !(count % setor)))
+		return pread(fd, buf, count, offset);
+	trecho_alinhado(setor, offset, count, &inicio, &tam);
+	tmp = valloc(tam);
+	if (!tmp) {
+		errno = ENOMEM;
+		return -1;
+	}
+	n = pread(fd, tmp, tam, inicio);
+	if (n < 0) {
+		r = -1;
+	} else {
+		desloc = offset - inicio;
+		disp = (s64)n - desloc;
+		r = disp <= 0 ? 0 : (disp < count ? disp : count);
+		if (r > 0)
+			memcpy(buf, tmp + desloc, r);
+	}
+	err = errno;
+	free(tmp);
+	errno = err;
+	return r;
+}
+
+static s64 pwrite_alinhado(int fd, u32 setor, const void *buf, s64 count, s64 offset)
+{
+	s64 inicio, tam, desloc, r;
+	ssize_t n;
+	char *tmp;
+	int err;
+
+	if (!setor || (!(offset % setor) && !(count % setor)))
+		return pwrite(fd, buf, count, offset);
+	trecho_alinhado(setor, offset, count, &inicio, &tam);
+	tmp = valloc(tam);
+	if (!tmp) {
+		errno = ENOMEM;
+		return -1;
+	}
+	desloc = offset - inicio;
+	n = pread(fd, tmp, tam, inicio);
+	if (n < 0) {
+		r = -1;
+	} else {
+		if (n < tam)
+			memset(tmp + n, 0, tam - n);
+		memcpy(tmp + desloc, buf, count);
+		n = pwrite(fd, tmp, tam, inicio);
+		if (n < 0)
+			r = -1;
+		else if (n >= tam)
+			r = count;
+		else
+			r = (s64)n > desloc ? (((s64)n - desloc) < count ? (s64)n - desloc : count) : 0;
+	}
+	err = errno;
+	free(tmp);
+	errno = err;
+	return r;
+}
+#endif /* __APPLE__ */
+
