--- a/ntfs-3g/src/lowntfs-3g.c	2026-10-17 17:40:39
+++ b/ntfs-3g/src/lowntfs-3g.c	2026-10-17 17:40:39
@@ -1009,6 +1009,20 @@
  * (17/10/2026). O kext confere a geração (fuse_node.c, "vnode changed generation"), como o do Tuxera (REA).
  */
 #define GERACAO_NTFS(ni)	((u64)le16_to_cpu((ni)->mrec->sequence_number) + 1)
+
+/*
+ * ntfsoficial: número entregue ao kext = registro MFT + número de sequência. Assim um arquivo que reaproveita
+ * o registro de outro recém-apagado chega como outro número, e o kext cria um vnode novo em vez de achar o
+ * velho (dados errados) ou devolver ESTALE na mudança de geração (os dois vistos no teste de estresse de
+ * 17/10/2026). O ntfs_inode_open() confere a sequência ("wrong SeqNo"), então um vnode velho nunca alcança
+ * o arquivo novo.
+ * O número é SEMPRE calculado do registro aberto (NO_FUSE_NI): a consulta por nome às vezes devolve a
+ * referência sem a sequência (cache de nomes), e calcular dela dava dois números para o mesmo arquivo
+ * (perdia dados ao anexar e renomear; visto no mesmo teste). A raiz continua com o número simples.
+ */
+#define NO_FUSE_NI(ni)	(((ni)->mft_no == FILE_root || !(ni)->mrec->sequence_number) ? \
+				(fuse_ino_t)(ni)->mft_no : \
+				(fuse_ino_t)MK_MREF((ni)->mft_no, le16_to_cpu((ni)->mrec->sequence_number)))
 
 static __inline__ BOOL ntfs_fuse_fillstat(struct SECURITY_CONTEXT *scx,
 			struct fuse_entry_param *pentry, u64 iref)
@@ -1016,9 +1030,9 @@
 	ntfs_inode *ni;
 	BOOL ok = FALSE;
 
