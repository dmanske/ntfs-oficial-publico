#!/bin/bash
# Depois de copiar os arquivos: o que scripts/instalar.sh faz depois da cópia.
# Sem "set -e": cada passo pode falhar sem estragar a instalação (o kext, por exemplo, só carrega
# depois que a pessoa aprova a extensão em Ajustes). Tudo vai para o log.
set -u
NOME="ntfsoficial"
IDENTIFICADOR="com.danielmanske.ntfsoficial"
ID_KEXT="${IDENTIFICADOR}.filesystems.${NOME}"
SERVICO="${IDENTIFICADOR}.desmontar"
PLIST_SERVICO="/Library/LaunchDaemons/${SERVICO}.plist"
PACOTE_FS="/Library/Filesystems/${NOME}.fs"
APP="/Applications/NTFS Oficial.app"
LOG="/private/var/log/ntfsoficial-instalacao.log"

exec >> "${LOG}" 2>&1
echo "=== $(date '+%F %T') postinstall: início ==="

echo "-> dono e permissões"
chown -R root:wheel "${PACOTE_FS}" "${APP}"
chown root:wheel "${PLIST_SERVICO}"; chmod 644 "${PLIST_SERVICO}"
# Carregar o kext precisa de root; quem monta pelo Finder pode não ser root (o load_ é setuid root)
chmod 4755 "${PACOTE_FS}/Contents/Resources/Support/load_${NOME}"
chmod 755 "${PACOTE_FS}/Contents/Resources/Support/desinstalar-ntfs-oficial.command" 2>/dev/null

echo "-> serviço de desmontagem ao desligar"
launchctl bootout system "${PLIST_SERVICO}" 2>/dev/null
launchctl bootstrap system "${PLIST_SERVICO}" || echo "AVISO: não foi possível carregar o serviço"
launchctl print "system/${SERVICO}" 2>/dev/null | grep -E '^\s*state'

echo "-> kext"
KEXT="${PACOTE_FS}/Contents/Extensions/${NOME}.kext"
KEXT_OK=0
# Kernel mais velho que a KPI que o kext declara: o kmutil recusa antes de pedir aprovação (0.2.0 pedia 27.0.0)
KPI="$(/usr/libexec/PlistBuddy -c 'Print :OSBundleLibraries:com.apple.kpi.bsd' "${KEXT}/Contents/Info.plist" 2>/dev/null)"
KERNEL="$(uname -r | cut -d. -f1)"
if kmutil showloaded --list-only 2>/dev/null | grep -q "${ID_KEXT}"; then
    KEXT_OK=1
elif [ -n "${KPI}" ] && [ "${KPI%%.*}" -gt "${KERNEL}" ]; then
    echo "ERRO: este kext pede o kernel ${KPI} ou mais novo; este Mac tem $(uname -r) (macOS $(sw_vers -productVersion))." \
         "Os discos ficam com o NTFS da Apple (só leitura)"
else
    # Num Mac novo o load dispara o pedido de aprovação (Ajustes -> Privacidade e Segurança); falhar aqui é esperado.
    # Códigos do load_ntfsoficial: 1 = falta aprovar (EPERM); 2 = kext não encontrado; 255 = outra falha.
    "${PACOTE_FS}/Contents/Resources/Support/load_${NOME}"
    CODIGO_LOAD=$?
    echo "load_${NOME} = ${CODIGO_LOAD}"
    if [ "${CODIGO_LOAD}" != 0 ]; then
        # Segunda tentativa: não sabemos qual dos dois dispara o pedido de aprovação
        kmutil load -p "${KEXT}"
        echo "kmutil load = $?"
        if [ "${CODIGO_LOAD}" = 1 ]; then
            echo "AVISO: falta aprovar a extensão em Ajustes → Privacidade e Segurança e reiniciar"
        else
            echo "AVISO: o kext não carregou (load_${NOME} = ${CODIGO_LOAD})"
            kmutil print-diagnostics -p "${KEXT}"
        fi
    fi
    kmutil showloaded --list-only 2>/dev/null | grep -q "${ID_KEXT}" && KEXT_OK=1
fi
if [ "${KEXT_OK}" = 1 ]; then
    GRUPO_ADMIN="$(dscl . -read /Groups/admin PrimaryGroupID | awk '{print $2}')"
    sysctl -w "vfs.generic.${NOME}.tunables.admin_group=${GRUPO_ADMIN}"
    sysctl -w "vfs.generic.${NOME}.tunables.allow_other=1"
else
    echo "(kext não carregado: sysctl pulados)"
fi

echo "-> diskarbitrationd relê os pacotes de sistema de arquivos"
launchctl kickstart -k system/com.apple.diskarbitrationd || echo "AVISO: kickstart do diskarbitrationd falhou"

echo "-> abrindo o app para o usuário logado"
USUARIO="$(stat -f '%Su' /dev/console 2>/dev/null)"
UID_USUARIO="$(id -u "${USUARIO}" 2>/dev/null)"
if [ -n "${USUARIO}" ] && [ "${USUARIO}" != "root" ] && [ -n "${UID_USUARIO}" ]; then
    launchctl asuser "${UID_USUARIO}" open "${APP}" || echo "AVISO: não foi possível abrir o app"
else
    echo "(ninguém logado: app não aberto)"
fi
echo "=== $(date '+%F %T') postinstall: fim ==="
exit 0
